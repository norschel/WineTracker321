<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color palette -->
    <Color x:Key="BurgundyColor">#7B2D42</Color>
    <Color x:Key="BurgundyLightColor">#A3435C</Color>
    <Color x:Key="CreamColor">#FAF6F0</Color>
    <Color x:Key="PanelBackColor">#F2EBE1</Color>
    <Color x:Key="BorderColor">#D9C8B8</Color>
    <Color x:Key="TextColor">#2E1A1A</Color>
    <Color x:Key="SubtleTextColor">#7A6060</Color>

    <SolidColorBrush x:Key="BurgundyBrush"      Color="{StaticResource BurgundyColor}"/>
    <SolidColorBrush x:Key="BurgundyLightBrush" Color="{StaticResource BurgundyLightColor}"/>
    <SolidColorBrush x:Key="CreamBrush"         Color="{StaticResource CreamColor}"/>
    <SolidColorBrush x:Key="PanelBackBrush"     Color="{StaticResource PanelBackColor}"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"          Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SubtleTextBrush"    Color="{StaticResource SubtleTextColor}"/>

    <!-- Window base -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource CreamBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- Label -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding"    Value="0,4,0,2"/>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Padding"          Value="6,4"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Background"       Value="White"/>
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="#C0392B"/>
                <Setter Property="ToolTip"
                        Value="{Binding (Validation.Errors)[0].ErrorContent,
                                        RelativeSource={RelativeSource Self}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background"      Value="White"/>
    </Style>

    <!-- Primary Button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background"  Value="{StaticResource BurgundyBrush}"/>
        <Setter Property="Foreground"  Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BurgundyBrush}"/>
        <Setter Property="Padding"     Value="14,6"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BurgundyLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background"  Value="White"/>
        <Setter Property="Foreground"  Value="{StaticResource BurgundyBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BurgundyBrush}"/>
        <Setter Property="Padding"     Value="14,6"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PanelBackBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar Button (icon-style) -->
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Margin"  Value="0,0,6,0"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <!-- ListView -->
    <Style TargetType="ListView">
        <Setter Property="BorderBrush"    Value="{StaticResource BorderBrush}"/>
        <Setter Property="Background"     Value="White"/>
        <Setter Property="AlternationCount" Value="2"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Padding"              Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="#F8F2EA"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BurgundyBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GridViewColumnHeader -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background"  Value="{StaticResource PanelBackBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource BurgundyBrush}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Padding"     Value="6,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <!-- Star display converter helper - star text -->
    <Style x:Key="StarText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C0A000"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- Section header in detail pane -->
    <Style x:Key="DetailLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BurgundyBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin"     Value="0,8,0,2"/>
    </Style>

    <Style x:Key="DetailValue" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Star radio button for rating -->
    <Style x:Key="StarRadio" TargetType="RadioButton">
        <Setter Property="FontSize"   Value="26"/>
        <Setter Property="Foreground" Value="#D0D0D0"/>
        <Setter Property="Margin"     Value="2,0"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <TextBlock Text="★"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Cursor="{TemplateBinding Cursor}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#C0A000"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#E0C000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
