<Window x:Class="WineTracker.Views.WineEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WineTracker.ViewModels"
        Title="{Binding WindowTitle}"
        Width="520" Height="560"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource CreamBrush}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Name -->
                <Label Grid.Row="0"  Grid.ColumnSpan="2" Content="Wine Name *"/>
                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <!-- Wineyard -->
                <Label Grid.Row="2" Content="Winery / Wineyard *"/>
                <!-- City -->
                <Label Grid.Row="2" Grid.Column="1" Content="City / Region *" Margin="8,0,0,0"/>

                <TextBox Grid.Row="3" Margin="0,0,4,4"
                         Text="{Binding Wineyard, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="4,0,0,4"
                         Text="{Binding City, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                <!-- Rating -->
                <Label Grid.Row="4" Content="Rating (1–5) *"/>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,4">
                    <RadioButton Content="★" Tag="1" Style="{StaticResource StarRadio}"
                                 IsChecked="{Binding IsRate1, Mode=TwoWay}"/>
                    <RadioButton Content="★" Tag="2" Style="{StaticResource StarRadio}"
                                 IsChecked="{Binding IsRate2, Mode=TwoWay}"/>
                    <RadioButton Content="★" Tag="3" Style="{StaticResource StarRadio}"
                                 IsChecked="{Binding IsRate3, Mode=TwoWay}"/>
                    <RadioButton Content="★" Tag="4" Style="{StaticResource StarRadio}"
                                 IsChecked="{Binding IsRate4, Mode=TwoWay}"/>
                    <RadioButton Content="★" Tag="5" Style="{StaticResource StarRadio}"
                                 IsChecked="{Binding IsRate5, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding Rate, StringFormat='{}{0} / 5'}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                </StackPanel>

                <!-- Rate description -->
                <Label Grid.Row="6" Grid.ColumnSpan="2" Content="Rating Description"/>
                <TextBox Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,4"
                         Text="{Binding RateDescription, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Description -->
                <Label Grid.Row="8" Grid.ColumnSpan="2" Content="Description / Tasting Notes"/>
                <TextBox Grid.Row="9" Grid.ColumnSpan="2" Margin="0,0,0,4"
                         Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Link -->
                <Label Grid.Row="10" Grid.ColumnSpan="2" Content="Link (URL)"/>
                <TextBox Grid.Row="11" Grid.ColumnSpan="2" Margin="0,0,0,4"
                         Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="12" Grid.ColumnSpan="2"
                           Text="* Required fields"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="11" Margin="0,4,0,0"/>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
