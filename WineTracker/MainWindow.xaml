<Window x:Class="WineTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WineTracker.ViewModels"
        mc:Ignorable="d"
        Title="🍷 Wine Tracker" Height="620" Width="960"
        MinHeight="450" MinWidth="700">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource BurgundyBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App title -->
                <TextBlock Grid.Column="0" Text="🍷 Wine Tracker"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>

                <!-- Search -->
                <Border Grid.Column="1" Background="White" CornerRadius="3"
                        BorderBrush="#FFFFFF60" BorderThickness="1" Padding="6,4"
                        VerticalAlignment="Center" MaxWidth="340" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                        <TextBox BorderThickness="0" Padding="0" MinWidth="240"
                                 Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="＋ Add"    Style="{StaticResource ToolbarButton}"
                            Command="{Binding AddCommand}"/>
                    <Button Content="✎ Edit"   Style="{StaticResource ToolbarButton}"
                            Command="{Binding EditCommand}"/>
                    <Button Content="🗑 Delete" Style="{StaticResource ToolbarButton}"
                            Command="{Binding DeleteCommand}"/>
                    <Button Content="🔗 Link"  Style="{StaticResource ToolbarButton}"
                            Command="{Binding OpenLinkCommand}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main content ────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Left: wine list -->
            <ListView Grid.Column="0"
                      ItemsSource="{Binding WinesView}"
                      SelectedItem="{Binding SelectedWine}"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{StaticResource BorderBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Winery" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Wineyard}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="City" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding City}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Rating" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource StarText}"
                                               Text="{Binding Rate, Converter={StaticResource StarsConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

                <!-- Empty state -->
                <ListView.Style>
                    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WinesView.IsEmpty}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border Background="{StaticResource CreamBrush}">
                                                <TextBlock Text="No wines yet — click ＋ Add to get started!"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="14"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
            </ListView>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Right: detail pane -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource PanelBackBrush}">
                <Border Padding="16">
                    <Grid>
                        <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWine}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Wine name heading -->
                        <TextBlock Text="{Binding SelectedWine.Name}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BurgundyBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Stars -->
                        <TextBlock Style="{StaticResource StarText}" FontSize="20"
                                   Text="{Binding SelectedWine.Rate, Converter={StaticResource StarsConverter}}"
                                   Margin="0,4,0,0"/>

                        <!-- Winery & City -->
                        <TextBlock Style="{StaticResource DetailLabel}" Text="Winery"/>
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedWine.Wineyard}"/>

                        <TextBlock Style="{StaticResource DetailLabel}" Text="City / Region"/>
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedWine.City}"/>

                        <!-- Rating description -->
                        <TextBlock Style="{StaticResource DetailLabel}" Text="Rating Note"/>
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedWine.RateDescription}"/>

                        <!-- Description -->
                        <TextBlock Style="{StaticResource DetailLabel}" Text="Description"/>
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SelectedWine.Description}"/>

                        <!-- Link -->
                        <TextBlock Style="{StaticResource DetailLabel}" Text="Link"/>
                        <TextBlock>
                            <Hyperlink NavigateUri="{Binding SelectedWine.Link}"
                                       RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="{StaticResource BurgundyBrush}">
                                <TextBlock Text="{Binding SelectedWine.Link}" TextWrapping="Wrap"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                        <!-- Placeholder when nothing selected -->
                        <TextBlock Text="Select a wine to see details"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWine}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

